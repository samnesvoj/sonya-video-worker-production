+"""Channel-subscription gate (owner request 2026-11-15).
+
+Users must be subscribed to REQUIRED_CHANNEL (e.g. @sonya_rf_ai) to use the
+bot. Non-subscribers get a «Подписаться» / «Я подписался» prompt instead of
+the handler. If the bot cannot check membership (not an admin of the
+channel, API error) the gate fails OPEN so the bot never goes dark.
+Disabled when REQUIRED_CHANNEL is empty.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import time
+from typing import Any, Awaitable, Callable
+
+from aiogram import BaseMiddleware, Bot
+from aiogram.types import (CallbackQuery, InlineKeyboardButton,
+                           InlineKeyboardMarkup, Message, TelegramObject)
+
+logger = logging.getLogger(__name__)
+
+CHECK_CB = "subgate:check"
+_OK_STATUSES = {"creator", "administrator", "member"}
+
+
+class SubscriptionGateMiddleware(BaseMiddleware):
+    def __init__(self, channel: str, admin_ids: set[int] | None = None) -> None:
+        self.channel = channel if channel.startswith("@") or channel.lstrip("-").isdigit() else "@" + channel
+        self.url = "https://t.me/" + self.channel.lstrip("@")
+        self.admin_ids = admin_ids or set()
+        self._ok_until: dict[int, float] = {}
+        self._warned = False
+
+    async def _is_subscribed(self, bot: Bot, user_id: int) -> bool:
+        now = time.monotonic()
+        if self._ok_until.get(user_id, 0) > now:
+            return True
+        try:
+            m = await bot.get_chat_member(self.channel, user_id)
+        except Exception as exc:  # bot not admin / network: fail open
+            if not self._warned:
+                logger.warning("subscription gate: cannot check %s (%s) - letting users through", self.channel, exc)
+                self._warned = True
+            return True
+        status = getattr(m.status, "value", m.status)
+        ok = status in _OK_STATUSES or (status == "restricted" and getattr(m, "is_member", False))
+        if ok:
+            self._ok_until[user_id] = now + 600
+        return ok
+
+    def _keyboard(self) -> InlineKeyboardMarkup:
+        return InlineKeyboardMarkup(inline_keyboard=[
+            [InlineKeyboardButton(text="Подписаться на SONYA AI", url=self.url)],
+            [InlineKeyboardButton(text="Я подписался ✓", callback_data=CHECK_CB)],
+        ])
+
+    TEXT = ("Чтобы пользоваться ботом SONYA, подпишитесь на наш канал — "
+            "там новости, примеры нарезок и бонусы.\n\nПосле подписки нажмите «Я подписался».")
+
+    async def __call__(self, handler: Callable[[TelegramObject, dict[str, Any]], Awaitable[Any]],
+                       event: TelegramObject, data: dict[str, Any]) -> Any:
+        user = getattr(event, "from_user", None)
+        chat = event.chat if isinstance(event, Message) else (event.message.chat if isinstance(event, CallbackQuery) and event.message else None)
+        if user is None or user.is_bot or chat is None or chat.type != "private" or user.id in self.admin_ids:
+            return await handler(event, data)
+        bot: Bot = data["bot"]
+        if isinstance(event, CallbackQuery) and event.data == CHECK_CB:
+            self._ok_until.pop(user.id, None)
+            if await self._is_subscribed(bot, user.id):
+                await event.answer("Спасибо за подписку!")
+                try:
+                    await event.message.edit_text("Спасибо за подписку! Теперь бот доступен — нажмите /start.")
+                except Exception:
+                    await bot.send_message(user.id, "Спасибо за подписку! Теперь бот доступен — нажмите /start.")
+            else:
+                await event.answer("Подписка пока не видна. Подпишитесь и нажмите ещё раз.", show_alert=True)
+            return None
+        if await self._is_subscribed(bot, user.id):
+            return await handler(event, data)
+        if isinstance(event, CallbackQuery):
+            await event.answer()
+            await bot.send_message(user.id, self.TEXT, reply_markup=self._keyboard())
+        else:
+            await event.answer(self.TEXT, reply_markup=self._keyboard())
+        return None
