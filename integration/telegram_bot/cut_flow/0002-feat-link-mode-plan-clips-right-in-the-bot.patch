+"""A link or a video sent to the bot -> the SONYA card (owner 2026-11-20). Logic: bot/services/cut_flow.py.
+
+Registered LAST in main_router, so commands / consent / FAQ keep their handlers. Plain text without a link is
+only taken when this person was asked for the segment start; anything else falls through untouched.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from aiogram import F, Router
+from aiogram.types import CallbackQuery, LinkPreviewOptions, Message
+
+from .. import cut_texts as T
+from ..services.cut_flow import TG_FILE_LIMIT, CutFlow
+from ..services.media import VideoMeta, find_link, parse_start, platform_of, probe
+
+logger = logging.getLogger(__name__)
+router = Router(name="cut")
+
+_NO_PREVIEW = LinkPreviewOptions(is_disabled=True)
+
+
+def _video_of(message: Message):
+    if message.video:
+        return message.video
+    d = message.document
+    if d and (d.mime_type or "").startswith("video/"):
+        return d
+    return None
+
+
+@router.message(F.chat.type == "private", F.text, ~F.text.startswith("/"))
+async def on_text(message: Message, cut_flow: CutFlow) -> None:
+    if message.from_user is None:
+        return
+    url = find_link(message.text)
+    if not url:
+        run = cut_flow.runs.latest(message.from_user.id, ("await_start",), max_age_sec=3600)
+        if run is None:
+            await message.answer("Пришлите ссылку на видео — YouTube, VK Видео, Rutube, Twitch — или сам файл, "
+                                 "и я сделаю клипы.\nВопрос по SONYA — напишите менеджеру @SonyaAiManager.")
+            return
+        sec = parse_start(message.text or "")
+        if sec is None:
+            await message.answer("Не понял время. Напишите, например, <code>25</code> (минута) или <code>1:10:00</code>.")
+            return
+        async with cut_flow.lock(run.id):
+            err = await cut_flow.set_segment(run, sec)
+        if err:
+            await message.answer(err)
+        return
+    platform = platform_of(url)
+    if platform is None:
+        await message.answer(T.UNSUPPORTED, link_preview_options=_NO_PREVIEW)
+        return
+    ph = await message.answer("Смотрю видео…", link_preview_options=_NO_PREVIEW)
+    meta = await probe(url)
+    run = cut_flow.new_run(message.from_user.id, message.chat.id, meta, url=url)
+    logger.info("cut: card run=%s platform=%s duration=%s", run.id, platform, int(meta.duration or 0))
+    await cut_flow.show_card(run, placeholder_id=ph.message_id)
+
+
+@router.message(F.chat.type == "private", F.video | F.document)
+async def on_video(message: Message, cut_flow: CutFlow) -> None:
+    if message.from_user is None:
+        return
+    v = _video_of(message)
+    if v is None:
+        await message.answer("Пришлите видео или ссылку на него — сделаю клипы.")
+        return
+    if v.file_size and v.file_size > TG_FILE_LIMIT:
+        await message.answer(T.TOO_BIG_FILE)
+        return
+    meta = VideoMeta(platform="file", title=(getattr(v, "file_name", None) or "")[:120],
+                     duration=float(v.duration) if getattr(v, "duration", None) else None)
+    run = cut_flow.new_run(message.from_user.id, message.chat.id, meta, file_id=v.file_id,
+                           file_name=getattr(v, "file_name", None) or "telegram_video.mp4", file_size=v.file_size)
+    await cut_flow.show_card(run)
+
+
+@router.callback_query(F.data.startswith("cut:"))
+async def on_callback(callback: CallbackQuery, cut_flow: CutFlow) -> None:
+    parts = (callback.data or "").split(":")
+    if len(parts) < 3 or callback.from_user is None:
+        await callback.answer()
+        return
+    run = cut_flow.runs.get(parts[1])
+    if run is None or run.user_id != callback.from_user.id:
+        await callback.answer("Эта карточка устарела. Пришлите ссылку ещё раз.", show_alert=True)
+        return
+    action, arg = parts[2], (parts[3] if len(parts) > 3 else "")
+    lock = cut_flow.lock(run.id)
+    if lock.locked():
+        await callback.answer("Секунду…")
+        return
+    async with lock:
+        run = cut_flow.runs.get(run.id) or run
+        alert = await _dispatch(cut_flow, run, action, arg)
+    await callback.answer(alert or None, show_alert=bool(alert and len(alert) > 40))
+
+
+async def _dispatch(flow: CutFlow, run, action: str, arg: str) -> str | None:
+    busy = run.state in ("starting", "ingest", "job", "delivering")
+    if action == "again":
+        new = flow.copy_run(run)
+        await flow.show_card(new)
+        return None
+    if busy:
+        return "Уже обрабатываю это видео."
+    if action == "m":
+        if arg not in T.CLIPS or (arg == "trailer" and not run.is_admin):
+            return None
+        run.clip = arg
+        run.trim_start = run.trim_end = None
+        await flow.proceed(run)
+    elif action == "q":
+        run.quality = "high" if arg == "high" else "standard"
+        await flow.back_to_card(run)
+    elif action == "std":
+        run.quality = "standard"
+        run.extra["quality_effective"] = "standard"
+        await flow.proceed(run)
+    elif action == "back":
+        run.trim_start = run.trim_end = None
+        await flow.back_to_card(run)
+    elif action == "relink":
+        acc = await flow.account(run.user_id)
+        if not (acc and acc.get("linked")):
+            return "Пока не вижу привязки. Войдите на сайте и нажмите «Подключить Telegram»."
+        await flow.proceed(run)
+    elif action == "tariffs":
+        await flow.show_tariffs(run)
+    elif action == "buy":
+        return await flow.buy(run, arg)
+    elif action == "paid":
+        if not await flow.check_payment(run):
+            return "Платёж пока не пришёл. Если вы оплатили — подождите минуту, я проверяю сам."
+    elif action == "first":
+        cap = (run.max_minutes or 60) * 60
+        run.trim_start, run.trim_end = 0.0, float(min(cap, run.duration or cap))
+        await flow.start(run)
+    elif action == "start_at":
+        run.state = "await_start"
+        flow.runs.save(run)
+        await flow.bot.send_message(run.chat_id, T.ask_start_text(run.max_minutes or 60))
+    return None
