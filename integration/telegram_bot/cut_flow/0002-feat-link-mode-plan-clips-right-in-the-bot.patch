+"""A local fake Telegram Bot API (just what @sonya_group_ai uses) + a scripted «user» to drive the real bot code.
+
+The bot process runs with TELEGRAM_API_BASE=http://127.0.0.1:<port> and talks to this server instead of Telegram.
+Everything the bot sends / edits is kept per message, so the final chat can be printed as a transcript.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+
+from aiohttp import web
+
+BOT_USER = {"id": 8659524434, "is_bot": True, "first_name": "SONYA", "username": "sonya_group_ai"}
+
+
+class FakeTelegram:
+    def __init__(self, member_ids=None):
+        self.updates: list[dict] = []
+        self.update_id = 1000
+        self.msg_id = 500
+        self.messages: dict[int, dict] = {}       # message_id -> current state (+ history of edits)
+        self.order: list[int] = []
+        self.alerts: list[tuple[float, str]] = []
+        self.calls: list[tuple[float, str]] = []
+        self.last_call = time.time()
+        self.member_ids = member_ids              # None = everybody subscribed
+        self.cond = asyncio.Condition()
+
+    # ── user side ────────────────────────────────────────────────────────────
+    def _user(self, uid):
+        return {"id": uid, "is_bot": False, "first_name": "Тест", "username": f"test{uid}", "language_code": "ru"}
+
+    async def push(self, upd: dict):
+        async with self.cond:
+            self.update_id += 1
+            upd["update_id"] = self.update_id
+            self.updates.append(upd)
+            self.cond.notify_all()
+
+    async def user_text(self, uid: int, text: str):
+        self.msg_id += 1
+        m = {"message_id": self.msg_id, "date": int(time.time()), "chat": {"id": uid, "type": "private"},
+             "from": self._user(uid), "text": text}
+        if text.startswith("/"):
+            m["entities"] = [{"type": "bot_command", "offset": 0, "length": len(text.split()[0])}]
+        self.messages[self.msg_id] = {"from": "user", "text": text, "history": []}
+        self.order.append(self.msg_id)
+        await self.push({"message": m})
+
+    async def user_video(self, uid: int, path: str, name: str = "interview.mp4", duration: int = 6):
+        import os
+        self.msg_id += 1
+        self.files = getattr(self, "files", {})
+        self.files["vid1"] = path
+        m = {"message_id": self.msg_id, "date": int(time.time()), "chat": {"id": uid, "type": "private"},
+             "from": self._user(uid), "video": {"file_id": "vid1", "file_unique_id": "vidu1", "width": 640,
+                                                 "height": 360, "duration": duration, "file_name": name,
+                                                 "mime_type": "video/mp4", "file_size": os.path.getsize(path)}}
+        self.messages[self.msg_id] = {"from": "user", "text": f"[видеофайл {name}, {duration} с]", "history": []}
+        self.order.append(self.msg_id)
+        await self.push({"message": m})
+
+    async def file(self, request: web.Request):
+        return web.FileResponse(self.files["vid1"])
+
+    def find_button(self, text_prefix: str):
+        for mid in reversed(self.order):
+            st = self.messages[mid]
+            for row in (st.get("markup") or {}).get("inline_keyboard", []):
+                for b in row:
+                    if b.get("text", "").startswith(text_prefix):
+                        return mid, b
+        raise KeyError(text_prefix)
+
+    async def click(self, uid: int, text_prefix: str):
+        mid, b = self.find_button(text_prefix)
+        if "callback_data" not in b:
+            raise ValueError(f"{text_prefix} is a url button: {b.get('url')}")
+        self.messages[mid].setdefault("clicks", []).append(b["text"])
+        await self.push({"callback_query": {"id": str(self.update_id), "from": self._user(uid), "chat_instance": "1",
+                                            "data": b["callback_data"],
+                                            "message": self._msg_json(mid, uid)}})
+
+    async def idle(self, quiet: float = 2.5, timeout: float = 60):
+        t0 = time.time()
+        while time.time() - t0 < timeout:
+            await asyncio.sleep(0.3)
+            if time.time() - self.last_call > quiet and not self.updates:
+                return
+        raise TimeoutError("bot did not settle")
+
+    async def wait_for(self, pred, timeout: float = 90):
+        t0 = time.time()
+        while time.time() - t0 < timeout:
+            try:
+                if pred():
+                    return True
+            except (KeyError, IndexError, ValueError):
+                pass
+            await asyncio.sleep(0.3)
+        raise TimeoutError("condition not reached")
+
+    def last_bot_text(self) -> str:
+        for mid in reversed(self.order):
+            st = self.messages[mid]
+            if st["from"] == "bot" and not st.get("deleted"):
+                return st.get("text") or st.get("caption") or ""
+        return ""
+
+    # ── bot side ─────────────────────────────────────────────────────────────
+    def _msg_json(self, mid: int, chat_id: int) -> dict:
+        st = self.messages[mid]
+        m = {"message_id": mid, "date": int(time.time()), "chat": {"id": chat_id, "type": "private"},
+             "from": BOT_USER if st["from"] == "bot" else self._user(chat_id)}
+        if st.get("photo"):
+            m["photo"] = [{"file_id": "ph", "file_unique_id": "phu", "width": 480, "height": 360}]
+            if st.get("caption"):
+                m["caption"] = st["caption"]
+        else:
+            m["text"] = st.get("text") or ""
+        if st.get("markup"):
+            m["reply_markup"] = st["markup"]
+        return m
+
+    @staticmethod
+    async def _params(request: web.Request) -> dict:
+        if request.content_type == "application/json":
+            return await request.json()
+        data = await request.post()
+        out = {}
+        for k, v in data.items():
+            out[k] = v if isinstance(v, str) else "<file>"
+        for k in ("reply_markup", "link_preview_options"):
+            if isinstance(out.get(k), str):
+                try:
+                    out[k] = json.loads(out[k])
+                except ValueError:
+                    pass
+        return out
+
+    async def handle(self, request: web.Request):
+        method = request.match_info["method"]
+        p = await self._params(request)
+        if method != "getUpdates":
+            self.last_call = time.time()
+            self.calls.append((time.time(), method))
+        ok = lambda r: web.json_response({"ok": True, "result": r})  # noqa: E731
+        if method == "getMe":
+            return ok(BOT_USER)
+        if method in ("deleteWebhook", "setMyCommands", "sendChatAction", "setChatMenuButton"):
+            return ok(True)
+        if method == "getFile":
+            import os
+            return ok({"file_id": p["file_id"], "file_unique_id": "u", "file_size": os.path.getsize(self.files["vid1"]),
+                       "file_path": "videos/file_1.mp4"})
+        if method == "getUpdates":
+            offset = int(p.get("offset") or 0)
+            timeout = min(float(p.get("timeout") or 0), 2.0)
+            async with self.cond:
+                self.updates = [u for u in self.updates if u["update_id"] >= offset]
+                if not self.updates and timeout:
+                    try:
+                        await asyncio.wait_for(self.cond.wait(), timeout)
+                    except asyncio.TimeoutError:
+                        pass
+                res = [u for u in self.updates if u["update_id"] >= offset]
+                self.updates = []
+            return ok(res)
+        if method == "getChatMember":
+            uid = int(p["user_id"])
+            status = "member" if self.member_ids is None or uid in self.member_ids else "left"
+            return ok({"status": status, "user": self._user(uid)})
+        if method in ("sendMessage", "sendPhoto"):
+            self.msg_id += 1
+            chat = int(p["chat_id"])
+            st = {"from": "bot", "history": [], "markup": p.get("reply_markup")}
+            if method == "sendPhoto":
+                st["photo"] = p.get("photo")
+                st["caption"] = p.get("caption")
+            else:
+                st["text"] = p.get("text")
+            self.messages[self.msg_id] = st
+            self.order.append(self.msg_id)
+            return ok(self._msg_json(self.msg_id, chat))
+        if method in ("editMessageText", "editMessageCaption", "editMessageReplyMarkup"):
+            mid = int(p["message_id"])
+            st = self.messages[mid]
+            st["history"].append(st.get("text") or st.get("caption"))
+            if method == "editMessageText":
+                if st.get("photo"):
+                    return web.json_response({"ok": False, "error_code": 400,
+                                              "description": "Bad Request: there is no text in the message to edit"}, status=400)
+                st["text"] = p.get("text")
+            elif method == "editMessageCaption":
+                st["caption"] = p.get("caption")
+            st["markup"] = p.get("reply_markup")
+            return ok(self._msg_json(mid, int(p["chat_id"])))
+        if method == "deleteMessage":
+            self.messages[int(p["message_id"])]["deleted"] = True
+            return ok(True)
+        if method == "answerCallbackQuery":
+            if p.get("text"):
+                self.alerts.append((time.time(), p["text"]))
+            return ok(True)
+        return web.json_response({"ok": False, "error_code": 400, "description": f"fake: {method} not supported"},
+                                 status=400)
+
+    def app(self) -> web.Application:
+        a = web.Application(client_max_size=60 * 1024 * 1024)
+        a.router.add_route("*", "/bot{token}/{method}", self.handle)
+        a.router.add_get("/file/bot{token}/{path:.*}", self.file)
+        return a
+
+    # ── transcript ───────────────────────────────────────────────────────────
+    def transcript(self) -> str:
+        import re
+        out = []
+        for mid in self.order:
+            st = self.messages[mid]
+            if st["from"] == "user":
+                out.append(f"\n👤 {st['text']}")
+                continue
+            body = st.get("caption") if st.get("photo") else st.get("text")
+            plain = re.sub(r"<[^>]+>", "", body or "").replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")
+            tag = "[превью] " if st.get("photo") else ""
+            if st.get("deleted"):
+                out.append(f"🤖 (удалено) {plain}")
+                continue
+            mid_frame = next((h for h in st["history"] if h and "● " in h), None)
+            if mid_frame:
+                out.append("🤖 ⋯ промежуточный вид:\n   " + re.sub(r"<[^>]+>", "", mid_frame).replace("\n", "\n   "))
+            if st["history"]:
+                steps = [re.sub(r"<[^>]+>", "", h or "").split("\n")[-1] for h in st["history"]]
+                out.append("🤖 (сообщение обновлялось %d раз: %s)" % (len(st["history"]), " → ".join(
+                    dict.fromkeys(s for s in steps if s))))
+            out.append("🤖 " + tag + plain.replace("\n", "\n   "))
+            for row in (st.get("markup") or {}).get("inline_keyboard", []):
+                out.append("   " + "  ".join(f"[{b['text']}{' ↗' if b.get('url') else ''}]" for b in row))
+            for c in st.get("clicks", []):
+                out.append(f"   👆 нажато: {c}")
+        if self.alerts:
+            out.append("\nВсплывающие ответы: " + " | ".join(a for _, a in self.alerts))
+        return "\n".join(out)
