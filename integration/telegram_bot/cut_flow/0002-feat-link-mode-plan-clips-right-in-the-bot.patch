diff --git a/bot/services/cut_api.py b/bot/services/cut_api.py
new file mode 100644
index 0000000..834f8c9
--- /dev/null
+++ b/bot/services/cut_api.py
@@ -0,0 +1,116 @@
+"""Client for the SONYA API bot bridge (/api/telegram/bot/*, scripts/bot_bridge_routes.py on the site VPS).
+
+Authenticated with SONYA_BOT_BRIDGE_SECRET (header X-Sonya-Bot-Secret), acts for the SONYA account linked to the
+Telegram user. Errors come back as CutApiError(status, code, message, detail) - never with the secret or a URL.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any
+
+import aiohttp
+
+from bot.config import SonyaApiConfig
+
+logger = logging.getLogger(__name__)
+
+
+class CutApiError(RuntimeError):
+    def __init__(self, status: int, code: str, message: str | None = None, detail: dict | None = None):
+        super().__init__(code)
+        self.status = status
+        self.code = code
+        self.message = message
+        self.detail = detail or {}
+
+
+class CutApi:
+    def __init__(self, config: SonyaApiConfig, timeout: float = 30.0) -> None:
+        self._config = config
+        self._timeout = aiohttp.ClientTimeout(total=timeout)
+
+    @property
+    def configured(self) -> bool:
+        return bool(self._config.base_url and self._config.bridge_secret)
+
+    def _url(self, path: str) -> str:
+        return (self._config.base_url or "").rstrip("/") + "/telegram/bot/" + path
+
+    def _headers(self) -> dict:
+        return {"X-Sonya-Bot-Secret": self._config.bridge_secret or ""}
+
+    @staticmethod
+    async def _result(resp: aiohttp.ClientResponse) -> Any:
+        try:
+            data = await resp.json(content_type=None)
+        except (json.JSONDecodeError, aiohttp.ContentTypeError, ValueError):
+            data = {}
+        if 200 <= resp.status < 300:
+            return data
+        detail = data.get("detail") if isinstance(data, dict) else None
+        if isinstance(detail, dict):
+            code = str(detail.get("code") or detail.get("error") or f"http_{resp.status}")
+            raise CutApiError(resp.status, code, detail.get("message"), detail)
+        raise CutApiError(resp.status, f"http_{resp.status}", detail if isinstance(detail, str) else None)
+
+    async def _post(self, path: str, payload: dict, timeout: float | None = None) -> Any:
+        if not self.configured:
+            raise CutApiError(0, "not_configured")
+        to = aiohttp.ClientTimeout(total=timeout) if timeout else self._timeout
+        try:
+            async with aiohttp.ClientSession(timeout=to) as s:
+                async with s.post(self._url(path), json=payload, headers=self._headers()) as resp:
+                    return await self._result(resp)
+        except CutApiError:
+            raise
+        except Exception as exc:  # network / timeout: no URL, no secret in the log
+            logger.warning("cut api %s unavailable: %s", path, type(exc).__name__)
+            raise CutApiError(0, "unavailable") from exc
+
+    async def account(self, tg: int) -> dict:
+        return await self._post("account", {"telegram_user_id": tg})
+
+    async def pricing(self) -> dict:
+        return await self._post("pricing", {})
+
+    async def job_from_url(self, tg: int, url: str, clip: str, quality: str, key: str,
+                           trim_start: float | None = None, trim_end: float | None = None) -> dict:
+        return await self._post("jobs/url", {"telegram_user_id": tg, "url": url, "clip": clip, "quality": quality,
+                                             "key": key, "trim_start_sec": trim_start, "trim_end_sec": trim_end})
+
+    async def job_from_file(self, tg: int, data: bytes, filename: str, clip: str, quality: str, key: str,
+                            trim_start: float | None = None, trim_end: float | None = None) -> dict:
+        if not self.configured:
+            raise CutApiError(0, "not_configured")
+        form = aiohttp.FormData()
+        form.add_field("telegram_user_id", str(tg))
+        form.add_field("clip", clip)
+        form.add_field("quality", quality)
+        form.add_field("key", key)
+        if trim_end:
+            form.add_field("trim_start_sec", str(trim_start or 0))
+            form.add_field("trim_end_sec", str(trim_end))
+        form.add_field("file", data, filename=filename or "telegram_video.mp4", content_type="video/mp4")
+        try:
+            async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=300)) as s:
+                async with s.post(self._url("jobs/file"), data=form, headers=self._headers()) as resp:
+                    return await self._result(resp)
+        except CutApiError:
+            raise
+        except Exception as exc:
+            logger.warning("cut api jobs/file unavailable: %s", type(exc).__name__)
+            raise CutApiError(0, "unavailable") from exc
+
+    async def ingest(self, tg: int, ingest_id: str) -> dict:
+        return await self._post("ingest", {"telegram_user_id": tg, "ingest_id": ingest_id})
+
+    async def job(self, tg: int, job_id: str) -> dict:
+        return await self._post("job", {"telegram_user_id": tg, "job_id": job_id})
+
+    async def checkout(self, tg: int, plan_id: str, key: str) -> dict:
+        return await self._post("checkout", {"telegram_user_id": tg, "plan_id": plan_id, "key": key}, timeout=45)
+
+    async def payment(self, tg: int, invoice_id: int) -> dict:
+        return await self._post("payment", {"telegram_user_id": tg, "invoice_id": invoice_id})
diff --git a/bot/services/cut_flow.py b/bot/services/cut_flow.py
new file mode 100644
index 0000000..b25ff6c
--- /dev/null
+++ b/bot/services/cut_flow.py
@@ -0,0 +1,476 @@
+"""«Ссылка → режим → подписка → нарезка» (owner 2026-11-20): the logic behind the card, shared by the handlers
+(bot/handlers/cut.py) and the background tracker (progress, payments, delivery). Telegram + the SONYA bridge only;
+billing, limits and refunds are the site's own (scripts/bot_bridge_routes.py)."""
+
+from __future__ import annotations
+
+import asyncio
+import io
+import logging
+import re
+import secrets
+import time
+
+from aiogram import Bot
+from aiogram.exceptions import TelegramBadRequest
+from aiogram.types import InlineKeyboardMarkup, LinkPreviewOptions
+
+from .. import cut_texts as T
+from .cut_api import CutApi, CutApiError
+from .cut_runs import Run, RunStore
+from .media import VideoMeta
+
+logger = logging.getLogger(__name__)
+
+SITE = "https://sonya.group"
+PAYWALL = ("FREE_PLAN_USED", "MODE_NOT_IN_PLAN", "SUBSCRIPTION_EXPIRED", "PLAN_LIMIT_REACHED")
+VIA_WORKER = ("youtube", "rutube", "twitch")       # the GPU worker downloads these (API source_fetch)
+TG_FILE_LIMIT = 20 * 1024 * 1024                    # Bot API getFile limit
+TICK = 6.0
+PAY_CHECK_EVERY = 15.0
+PAY_WAIT_SEC = 45 * 60
+JOB_TRACK_SEC = 8 * 3600
+DELIVERY_WAIT_SEC = 20 * 60
+MAX_RUNNING = 3
+_NO_PREVIEW = LinkPreviewOptions(is_disabled=True)
+
+
+class CutFlow:
+    def __init__(self, bot: Bot, api: CutApi, runs: RunStore) -> None:
+        self.bot = bot
+        self.api = api
+        self.runs = runs
+        self._locks: dict[str, asyncio.Lock] = {}
+        self._pricing: tuple[float, list] = (0.0, [])
+        self._task: asyncio.Task | None = None
+
+    def lock(self, run_id: str) -> asyncio.Lock:
+        return self._locks.setdefault(run_id, asyncio.Lock())
+
+    # ── account / pricing ──────────────────────────────────────────────────
+    async def account(self, tg: int) -> dict | None:
+        try:
+            return await self.api.account(tg)
+        except CutApiError as exc:
+            logger.warning("cut: account lookup failed code=%s", exc.code)
+            return None
+
+    async def plans(self) -> list[dict]:
+        ts, plans = self._pricing
+        if plans and time.time() - ts < 600:
+            return plans
+        data = await self.api.pricing()
+        plans = list(data.get("plans") or [])
+        self._pricing = (time.time(), plans)
+        return plans
+
+    @staticmethod
+    def _urls(acc: dict | None) -> dict:
+        u = (acc or {}).get("urls") or {}
+        return {"presets": u.get("presets") or SITE + "/#/presets", "works": u.get("works") or SITE + "/#/works",
+                "tariffs": u.get("tariffs") or SITE + "/?paywall=1", "connect": (acc or {}).get("connect_url")
+                or SITE + "/?tg=connect"}
+
+    @staticmethod
+    def _quality_on(acc: dict | None) -> bool:
+        return bool(((acc or {}).get("quality") or {}).get("available", True))
+
+    # ── rendering: the card message is edited in place ───────────────────
+    async def render(self, run: Run, text: str, kb: InlineKeyboardMarkup | None = None) -> None:
+        if text == run.last_text and kb is None and run.card_msg_id:
+            self.runs.save(run)
+            return
+        sent = False
+        if run.card_msg_id:
+            try:
+                if run.card_is_photo:
+                    await self.bot.edit_message_caption(chat_id=run.chat_id, message_id=run.card_msg_id,
+                                                        caption=text, reply_markup=kb)
+                else:
+                    await self.bot.edit_message_text(chat_id=run.chat_id, message_id=run.card_msg_id, text=text,
+                                                     reply_markup=kb, link_preview_options=_NO_PREVIEW)
+                sent = True
+            except TelegramBadRequest as exc:
+                sent = "not modified" in str(exc).lower()   # else: deleted / too old -> a new message below
+        if not sent:
+            m = await self.bot.send_message(run.chat_id, text, reply_markup=kb, link_preview_options=_NO_PREVIEW)
+            run.card_msg_id, run.card_is_photo = m.message_id, False
+        run.last_text = text
+        self.runs.save(run)
+
+    async def show_card(self, run: Run, placeholder_id: int | None = None) -> None:
+        acc = await self.account(run.user_id)
+        if acc and acc.get("linked"):
+            run.is_admin = bool(acc.get("is_admin"))
+            run.preset = str((acc.get("preset") or {}).get("name") or "")
+            if (acc.get("preset") or {}).get("quality") == "high" and self._quality_on(acc):
+                run.quality = "high"
+        q_on = self._quality_on(acc)
+        text = T.card_text(run, q_on)
+        kb = T.card_keyboard(run, self._urls(acc)["presets"], q_on)
+        run.state = "card"
+        if run.thumb:
+            try:
+                m = await self.bot.send_photo(run.chat_id, run.thumb, caption=text, reply_markup=kb)
+                run.card_msg_id, run.card_is_photo = m.message_id, True
+                if placeholder_id:
+                    await self._delete(run.chat_id, placeholder_id)
+                run.last_text = text
+                self.runs.save(run)
+                return
+            except Exception as exc:  # noqa: BLE001 - a preview Telegram can't fetch: text card
+                logger.info("cut: preview not sent (%s)", type(exc).__name__)
+        run.card_msg_id, run.card_is_photo = placeholder_id, False
+        run.last_text = ""
+        await self.render(run, text, kb)
+
+    async def _delete(self, chat_id: int, message_id: int) -> None:
+        try:
+            await self.bot.delete_message(chat_id, message_id)
+        except Exception:  # noqa: BLE001
+            pass
+
+    async def back_to_card(self, run: Run) -> None:
+        acc = await self.account(run.user_id)
+        run.state = "card"
+        q_on = self._quality_on(acc)
+        await self.render(run, T.card_text(run, q_on), T.card_keyboard(run, self._urls(acc)["presets"], q_on))
+
+    # ── a new source ───────────────────────────────────────────────────────
+    def new_run(self, user_id: int, chat_id: int, meta: VideoMeta, url: str | None = None,
+                file_id: str | None = None, file_name: str | None = None, file_size: int | None = None) -> Run:
+        return self.runs.new(user_id, chat_id, url=url, file_id=file_id, file_name=file_name, file_size=file_size,
+                             platform=meta.platform, title=meta.title, duration=meta.duration, thumb=meta.thumb)
+
+    def copy_run(self, run: Run) -> Run:
+        return self.runs.new(run.user_id, run.chat_id, url=run.url, file_id=run.file_id, file_name=run.file_name,
+                             file_size=run.file_size, platform=run.platform, title=run.title, duration=run.duration,
+                             thumb=run.thumb, quality=run.quality, preset=run.preset, is_admin=run.is_admin)
+
+    # ── the decision chain after a mode is picked ──────────────────────────
+    async def proceed(self, run: Run) -> None:
+        acc = await self.account(run.user_id)
+        if acc is None:
+            await self.fail(run, T.DOWN, retry=True)
+            return
+        urls = self._urls(acc)
+        if not acc.get("linked"):
+            run.state = "need_link"
+            await self.render(run, T.link_text(run), T.link_keyboard(run, urls["connect"]))
+            return
+        run.is_admin = bool(acc.get("is_admin"))
+        run.preset = str((acc.get("preset") or {}).get("name") or "")
+        access = (acc.get("access") or {}).get(run.clip or "")
+        if access is None:
+            await self.back_to_card(run)
+            return
+        if not access.get("allowed"):
+            await self.show_tariffs(run, access.get("code"), access.get("message"))
+            return
+        if run.clip not in T.HIGH_CLIPS or not self._quality_on(acc):
+            run.extra["quality_effective"] = "standard"
+        else:
+            run.extra["quality_effective"] = run.quality
+        units = int(((acc.get("quality") or {}).get("units")) or 3)
+        left = access.get("left")
+        if run.extra["quality_effective"] == "high" and left is not None and left < units:
+            await self.offer_standard(run, T.escape(
+                f"Качество 2K списывает {units} обработки, а осталось {left}. Стандарт списывает 1."))
+            return
+        cap = int(access.get("max_source_minutes") or 0)
+        run.max_minutes = cap or None
+        if cap and run.duration and run.duration > cap * 60 + 2 and not run.trim_end:
+            await self.ask_segment(run)
+            return
+        await self.start(run)
+
+    async def offer_standard(self, run: Run, reason: str) -> None:
+        from aiogram.types import InlineKeyboardButton as B
+        run.state = "card"
+        kb = InlineKeyboardMarkup(inline_keyboard=[
+            [B(text="Запустить в Стандарте", callback_data=T.cb(run.id, "std"))],
+            [B(text="Тарифы", callback_data=T.cb(run.id, "tariffs")), B(text="Назад", callback_data=T.cb(run.id, "back"))],
+        ])
+        await self.render(run, f"{T.header(run)}\n\n{reason}", kb)
+
+    async def show_tariffs(self, run: Run, code: str | None = None, message: str | None = None) -> None:
+        plan_mode = T.PLAN_MODE_OF_CLIP.get(run.clip or "viral", "cut")
+        try:
+            plans = await self.plans()
+        except CutApiError:
+            await self.fail(run, T.DOWN, retry=True)
+            return
+        if not T.plans_for(plans, plan_mode):
+            await self.fail(run, T.reason_text(code, message), retry=True)
+            return
+        run.state = "tariffs"
+        if code:
+            run.extra["deny_code"], run.extra["deny_msg"] = code, message
+        acc_urls = self._urls(None)
+        await self.render(run, T.tariffs_text(run, plans, plan_mode, run.extra.get("deny_code"),
+                                              run.extra.get("deny_msg")),
+                          T.tariffs_keyboard(run, plans, plan_mode, acc_urls["tariffs"]))
+
+    async def buy(self, run: Run, plan_id: str) -> str | None:
+        """Create the site's ЮKassa payment for the linked account. Returns an alert text for the callback, if any."""
+        plans = await self.plans()
+        plan = next((p for p in plans if p["plan_id"] == plan_id), None)
+        if plan is None:
+            return "Тариф не найден."
+        try:
+            res = await self.api.checkout(run.user_id, plan_id, key=f"{run.key}-{plan_id}")
+        except CutApiError as exc:
+            if exc.code == "subscription_active":
+                await self.proceed(run)
+                return "Этот тариф у вас уже активен."
+            if exc.status == 401:
+                await self.proceed(run)
+                return None
+            if exc.code in ("payment_unavailable", "payment_provider_unavailable", "unavailable"):
+                return "Оплата сейчас недоступна. Попробуйте через минуту или оформите на сайте."
+            return "Не получилось создать платёж. Попробуйте ещё раз."
+        if res.get("status") == "paid":
+            await self.proceed(run)
+            return None
+        run.invoice_id = int(res["invoice_id"]) if res.get("invoice_id") is not None else None
+        run.plan_id, run.pay_url = plan_id, res.get("redirect_url")
+        if not run.pay_url:
+            return "Не получилось создать платёж. Попробуйте ещё раз."
+        run.state = "await_payment"
+        run.extra["pay_since"] = time.time()
+        await self.render(run, T.pay_text(run, plan), T.pay_keyboard(run, plan, run.pay_url))
+        return None
+
+    async def check_payment(self, run: Run) -> bool:
+        if not run.invoice_id:
+            return False
+        try:
+            st = await self.api.payment(run.user_id, run.invoice_id)
+        except CutApiError:
+            return False
+        if st.get("status") == "paid":
+            logger.info("cut: payment paid run=%s plan=%s", run.id, run.plan_id)
+            run.invoice_id = None
+            await self.proceed(run)
+            return True
+        if st.get("status") in ("failed", "canceled", "cancelled"):
+            run.invoice_id = None
+            await self.show_tariffs(run)
+        return False
+
+    async def ask_segment(self, run: Run, cap: int | None = None) -> None:
+        cap = cap or run.max_minutes or 60
+        run.max_minutes = cap
+        run.state = "need_segment"
+        await self.render(run, T.segment_text(run, cap), T.segment_keyboard(run, cap))
+
+    async def set_segment(self, run: Run, start_sec: float) -> str | None:
+        cap = (run.max_minutes or 60) * 60
+        if run.duration and start_sec >= run.duration - 5:
+            return "Это позже конца видео. Напишите начало раньше."
+        end = start_sec + cap
+        if run.duration:
+            end = min(end, run.duration)
+        run.trim_start, run.trim_end = float(start_sec), float(end)
+        await self.start(run)
+        return None
+
+    # ── start ──────────────────────────────────────────────────────────────
+    async def start(self, run: Run) -> None:
+        if self.runs.count_running(run.user_id) >= MAX_RUNNING:
+            await self.fail(run, T.BUSY, retry=True)
+            return
+        run.state, run.stage, run.notice, run.error = "starting", None, None, None
+        run.key = secrets.token_hex(8)               # a new attempt = a new idempotency key
+        run.started_at = time.time()
+        quality = run.extra.get("quality_effective") or "standard"
+        await self.render(run, T.progress_text(run))
+        try:
+            if run.url:
+                res = await self.api.job_from_url(run.user_id, run.url, run.clip or "viral", quality, run.key,
+                                                  run.trim_start, run.trim_end)
+                run.ingest_id, run.state, run.stage = res.get("ingest_id"), "ingest", "download"
+                run.extra["downloaded"] = False
+            else:
+                data = await self._download_tg(run)
+                if data is None:
+                    await self.fail(run, T.TOO_BIG_FILE)
+                    return
+                res = await self.api.job_from_file(run.user_id, data, run.file_name or "telegram_video.mp4",
+                                                   run.clip or "viral", quality, run.key, run.trim_start, run.trim_end)
+                run.job_id, run.state, run.stage = res.get("job_id"), "job", "queue"
+                run.extra["downloaded"] = True
+        except CutApiError as exc:
+            await self.on_api_error(run, exc)
+            return
+        logger.info("cut: started run=%s clip=%s src=%s", run.id, run.clip, "url" if run.url else "file")
+        await self.render(run, T.progress_text(run))
+
+    async def _download_tg(self, run: Run) -> bytes | None:
+        if run.file_size and run.file_size > TG_FILE_LIMIT:
+            return None
+        buf = io.BytesIO()
+        try:
+            await self.bot.download(run.file_id, destination=buf, timeout=120)
+        except TelegramBadRequest:
+            return None
+        return buf.getvalue()
+
+    async def on_api_error(self, run: Run, exc: CutApiError) -> None:
+        d = exc.detail or {}
+        if exc.status == 401 and exc.code == "not_linked":
+            await self.proceed(run)
+        elif exc.status == 402 and exc.code in PAYWALL:
+            await self.show_tariffs(run, exc.code, exc.message)
+        elif exc.code == "QUALITY_UNITS_SHORT":
+            await self.offer_standard(run, T.escape(exc.message or "Для 2K не хватает обработок."))
+        elif exc.code == "SOURCE_TOO_LONG" or exc.status == 413:
+            if d.get("source_minutes") and not run.duration:
+                run.duration = float(d["source_minutes"]) * 60
+            await self.ask_segment(run, int(d.get("max_source_minutes") or run.max_minutes or 60))
+        elif exc.status == 429:
+            daily = str(d.get("reason") or "") == "daily_limit_reached"
+            await self.fail(run, "На сегодня лимит запусков исчерпан — попробуйте завтра." if daily else T.BUSY,
+                            retry=True)
+        else:
+            await self.fail(run, T.human_error(exc.code, exc.message), retry=True)
+
+    async def fail(self, run: Run, reason: str, retry: bool = True) -> None:
+        run.state = "failed"
+        run.error = reason
+        await self.render(run, T.failed_text(run, reason), T.failed_keyboard(run) if retry else None)
+
+    # ── link done elsewhere (site → deep link /start TOKEN) ────────────────
+    async def resume_after_link(self, user_id: int) -> bool:
+        run = self.runs.latest(user_id, ("need_link",), max_age_sec=3 * 3600)
+        if not run:
+            return False
+        async with self.lock(run.id):
+            # the old card is far up the chat now: close it, carry on in a new message at the bottom
+            await self.render(run, f"{T.header(run)}\n\nАккаунт привязан — продолжаю ниже.")
+            run.card_msg_id, run.card_is_photo, run.last_text = None, False, ""
+            await self.proceed(run)
+        return True
+
+    # ── background: progress / payment / delivery ──────────────────────────
+    def start_tracker(self) -> None:
+        if self._task is None:
+            self._task = asyncio.create_task(self._loop())
+
+    async def _loop(self) -> None:
+        n = 0
+        while True:
+            try:
+                for run in self.runs.active():
+                    lk = self.lock(run.id)
+                    if lk.locked():
+                        continue
+                    async with lk:
+                        fresh = self.runs.get(run.id)
+                        if fresh and fresh.state == run.state:
+                            await self.tick(fresh)
+                n += 1
+                if n % 600 == 0:
+                    self.runs.prune()
+            except asyncio.CancelledError:
+                raise
+            except Exception as exc:  # noqa: BLE001 - the loop never dies
+                logger.warning("cut tracker pass failed: %s", type(exc).__name__)
+            await asyncio.sleep(TICK)
+
+    async def tick(self, run: Run) -> None:
+        now = time.time()
+        try:
+            if run.state == "await_payment":
+                if now - float(run.extra.get("pay_checked") or 0) >= PAY_CHECK_EVERY:
+                    run.extra["pay_checked"] = now
+                    self.runs.save(run)
+                    if not await self.check_payment(run) and now - float(run.extra.get("pay_since") or now) > PAY_WAIT_SEC:
+                        run.state = "tariffs"           # stop polling; «Я оплатил» still works
+                        self.runs.save(run)
+            elif run.state == "ingest":
+                await self._tick_ingest(run)
+            elif run.state == "job":
+                await self._tick_job(run)
+            elif run.state == "delivering":
+                await self._tick_delivery(run)
+            elif run.state == "starting" and now - (run.started_at or now) > 600:
+                await self.fail(run, T.DOWN)
+        except CutApiError as exc:
+            if exc.status == 404 and run.state == "ingest":
+                await self.fail(run, "Загрузка по ссылке прервалась. Попробуйте ещё раз — обработка не списана.")
+            elif exc.status in (401,):
+                await self.fail(run, "Аккаунт SONYA отвязан от этого Telegram. Клипы будут в «Работах» на сайте.")
+            else:
+                logger.info("cut: tick run=%s api %s", run.id, exc.code)
+
+    async def _tick_ingest(self, run: Run) -> None:
+        st = await self.api.ingest(run.user_id, run.ingest_id or "")
+        status = st.get("status")
+        if status == "queued" and st.get("job_id"):
+            run.job_id, run.state, run.stage = st["job_id"], "job", "queue"
+            run.extra["downloaded"] = run.platform not in VIA_WORKER
+            await self.render(run, T.progress_text(run))
+        elif status == "failed":
+            code = str(st.get("error") or "")
+            if code in PAYWALL:
+                await self.show_tariffs(run, code, st.get("message"))
+            elif code == "SOURCE_TOO_LONG":
+                if st.get("source_minutes"):
+                    run.duration = float(st["source_minutes"]) * 60
+                await self.ask_segment(run, int(st.get("max_source_minutes") or run.max_minutes or 60))
+            else:
+                await self.fail(run, T.human_error(code, st.get("message")) + T.NOT_CHARGED)
+        else:
+            run.stage = "download"
+            await self.render(run, T.progress_text(run))
+
+    async def _tick_job(self, run: Run) -> None:
+        now = time.time()
+        j = await self.api.job(run.user_id, run.job_id or "")
+        status, stage = j.get("status"), j.get("stage")
+        notice = None
+        if status == "source_wait":
+            notice = T.NOTICE_YT
+        elif j.get("notice"):
+            notice = T.NOTICE_LOAD
+        run.notice = notice
+        if stage == "done":
+            run.clips = int(j.get("clips") or 0)
+            run.stage, run.state, run.done_at = "done", "delivering", now
+            run.extra["works_url"] = j.get("works_url")
+            await self.render(run, T.done_text(run))
+            return
+        if stage == "failed":
+            code, msg = j.get("error_code"), j.get("error")
+            if code == "SOURCE_TOO_LONG" or (msg and "максимум" in str(msg) and "мин" in str(msg)):
+                m = re.search(r"(\d+)\s*мин", str(msg or ""))
+                if m and not run.duration:
+                    run.duration = float(m.group(1)) * 60
+                await self.ask_segment(run)
+                return
+            reason = T.human_error(code, msg)
+            if j.get("refunded"):
+                reason += T.NOT_CHARGED
+            await self.fail(run, reason)
+            return
+        run.stage = stage
+        if now - (run.started_at or now) > JOB_TRACK_SEC:
+            run.state = "done"
+            await self.render(run, T.progress_text(run) + "\n\nОбработка идёт дольше обычного — клипы придут сюда, "
+                                                         "как только будут готовы.")
+            return
+        await self.render(run, T.progress_text(run))
+
+    async def _tick_delivery(self, run: Run) -> None:
+        now = time.time()
+        j = await self.api.job(run.user_id, run.job_id or "")
+        delivered = j.get("delivered")
+        settled = int(delivered or 0) + int(j.get("delivery_failed") or 0)
+        if (delivered is not None and settled >= run.clips) or now - (run.done_at or now) > DELIVERY_WAIT_SEC \
+                or run.clips == 0:
+            run.state = "done"
+            self.runs.save(run)
+            await asyncio.sleep(1.5)                    # let the last clip land first
+            await self.bot.send_message(run.chat_id, T.final_text(run),
+                                        reply_markup=T.final_keyboard(run, run.extra.get("works_url") or SITE + "/#/works"))
diff --git a/bot/services/cut_runs.py b/bot/services/cut_runs.py
new file mode 100644
index 0000000..da5c92a
--- /dev/null
+++ b/bot/services/cut_runs.py
@@ -0,0 +1,133 @@
+"""One «run» = one video a person sent the bot: card -> mode -> (link / plan / segment) -> job -> clips.
+
+Kept in the bot's sqlite (same file as users/consents) so a bot restart resumes the progress messages.
+States: card, need_link, tariffs, await_payment, need_segment, await_start, starting, ingest, job, delivering,
+done, failed, cancelled.
+"""
+
+from __future__ import annotations
+
+import json
+import secrets
+import sqlite3
+import threading
+import time
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+ACTIVE = ("starting", "ingest", "job", "delivering", "await_payment")
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS cut_runs (
+    id TEXT PRIMARY KEY,
+    user_id INTEGER NOT NULL,
+    chat_id INTEGER NOT NULL,
+    data TEXT NOT NULL,
+    state TEXT NOT NULL,
+    created REAL NOT NULL,
+    updated REAL NOT NULL
+);
+CREATE INDEX IF NOT EXISTS cut_runs_user ON cut_runs(user_id, updated);
+CREATE INDEX IF NOT EXISTS cut_runs_state ON cut_runs(state);
+"""
+
+
+@dataclass
+class Run:
+    id: str
+    user_id: int
+    chat_id: int
+    state: str = "card"
+    url: str | None = None
+    file_id: str | None = None
+    file_name: str | None = None
+    file_size: int | None = None
+    platform: str = "link"
+    title: str = ""
+    duration: float | None = None
+    thumb: str | None = None
+    card_msg_id: int | None = None
+    card_is_photo: bool = False
+    clip: str | None = None
+    quality: str = "standard"
+    trim_start: float | None = None
+    trim_end: float | None = None
+    max_minutes: int | None = None
+    key: str = ""
+    ingest_id: str | None = None
+    job_id: str | None = None
+    stage: str | None = None
+    notice: str | None = None
+    clips: int = 0
+    invoice_id: int | None = None
+    plan_id: str | None = None
+    pay_url: str | None = None
+    preset: str = ""
+    is_admin: bool = False
+    last_text: str = ""
+    error: str | None = None
+    started_at: float | None = None
+    done_at: float | None = None
+    extra: dict = field(default_factory=dict)
+    created: float = 0.0
+    updated: float = 0.0
+
+
+class RunStore:
+    def __init__(self, db_path: Path | str) -> None:
+        self._path = str(db_path)
+        self._lock = threading.Lock()
+        Path(self._path).parent.mkdir(parents=True, exist_ok=True)
+        with self._conn() as c:
+            c.executescript(_SCHEMA)
+
+    def _conn(self) -> sqlite3.Connection:
+        return sqlite3.connect(self._path, timeout=10)
+
+    def new(self, user_id: int, chat_id: int, **fields) -> Run:
+        now = time.time()
+        run = Run(id=secrets.token_hex(4), user_id=user_id, chat_id=chat_id, key=secrets.token_hex(8),
+                  created=now, updated=now, **fields)
+        self.save(run)
+        return run
+
+    def save(self, run: Run) -> None:
+        run.updated = time.time()
+        d = asdict(run)
+        with self._lock, self._conn() as c:
+            c.execute("INSERT INTO cut_runs(id,user_id,chat_id,data,state,created,updated) VALUES(?,?,?,?,?,?,?) "
+                      "ON CONFLICT(id) DO UPDATE SET data=excluded.data, state=excluded.state, updated=excluded.updated",
+                      (run.id, run.user_id, run.chat_id, json.dumps(d, ensure_ascii=False), run.state,
+                       run.created, run.updated))
+
+    @staticmethod
+    def _load(row) -> Run:
+        d = json.loads(row[0])
+        known = set(Run.__dataclass_fields__)
+        return Run(**{k: v for k, v in d.items() if k in known})
+
+    def get(self, run_id: str) -> Run | None:
+        with self._conn() as c:
+            row = c.execute("SELECT data FROM cut_runs WHERE id=?", (run_id,)).fetchone()
+        return self._load(row) if row else None
+
+    def active(self) -> list[Run]:
+        q = "SELECT data FROM cut_runs WHERE state IN (%s) ORDER BY updated" % ",".join("?" * len(ACTIVE))
+        with self._conn() as c:
+            return [self._load(r) for r in c.execute(q, ACTIVE).fetchall()]
+
+    def latest(self, user_id: int, states: tuple[str, ...], max_age_sec: float = 3600) -> Run | None:
+        q = ("SELECT data FROM cut_runs WHERE user_id=? AND updated>? AND state IN (%s) ORDER BY updated DESC LIMIT 1"
+             % ",".join("?" * len(states)))
+        with self._conn() as c:
+            row = c.execute(q, (user_id, time.time() - max_age_sec, *states)).fetchone()
+        return self._load(row) if row else None
+
+    def count_running(self, user_id: int) -> int:
+        with self._conn() as c:
+            return c.execute("SELECT count(*) FROM cut_runs WHERE user_id=? AND state IN ('starting','ingest','job')",
+                             (user_id,)).fetchone()[0]
+
+    def prune(self, max_age_sec: float = 14 * 86400) -> None:
+        with self._lock, self._conn() as c:
+            c.execute("DELETE FROM cut_runs WHERE updated < ?", (time.time() - max_age_sec,))
diff --git a/bot/services/media.py b/bot/services/media.py
new file mode 100644
index 0000000..e5a3c1d
--- /dev/null
+++ b/bot/services/media.py
@@ -0,0 +1,163 @@
+"""Links the bot accepts + the video's title / length / preview WITHOUT downloading it.
+
+Metadata: `yt-dlp -J --skip-download` (the YouTube relay's yt-dlp on this server, YTDLP_BIN), hard timeout;
+fallback for YouTube = the public oEmbed (title + preview, no length). Anything failing -> an empty card
+(the job itself still checks the length on the server).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+import re
+from dataclasses import dataclass, field
+
+import aiohttp
+
+logger = logging.getLogger(__name__)
+
+YTDLP_BIN = os.environ.get("YTDLP_BIN", "/opt/sonya-ytrelay/venv/bin/yt-dlp")
+PROBE_TIMEOUT = float(os.environ.get("BOT_PROBE_TIMEOUT", "20"))
+
+_URL_RE = re.compile(r"https?://[^\s<>\"']+", re.I)
+_PLATFORMS = (
+    ("youtube", re.compile(r"^https?://(?:[a-z0-9-]+\.)?(?:youtube\.com|youtu\.be)/", re.I)),
+    ("vk", re.compile(r"^https?://(?:[a-z0-9-]+\.)?(?:vk\.com|vk\.ru|vkvideo\.ru)/", re.I)),
+    ("rutube", re.compile(r"^https?://(?:[a-z0-9-]+\.)?rutube\.ru/", re.I)),
+    ("twitch", re.compile(r"^https?://(?:[a-z0-9-]+\.)?twitch\.tv/", re.I)),
+)
+PLATFORM_RU = {"youtube": "YouTube", "vk": "VK Видео", "rutube": "Rutube", "twitch": "Twitch", "file": "Файл"}
+_YT_ID = re.compile(r"(?:v=|youtu\.be/|shorts/|live/|embed/)([A-Za-z0-9_-]{11})")
+
+
+@dataclass
+class VideoMeta:
+    platform: str
+    title: str = ""
+    duration: float | None = None
+    thumb: str | None = None
+    uploader: str = ""
+    extra: dict = field(default_factory=dict)
+
+
+def find_link(text: str | None) -> str | None:
+    """The first http(s) link in a message (trailing punctuation stripped)."""
+    if not text:
+        return None
+    m = _URL_RE.search(text)
+    return m.group(0).rstrip(").,;!?»\"'") if m else None
+
+
+def platform_of(url: str) -> str | None:
+    for name, rx in _PLATFORMS:
+        if rx.match(url):
+            return name
+    return None
+
+
+def fmt_duration(sec: float | None) -> str:
+    if not sec:
+        return ""
+    s = int(round(sec))
+    h, m = divmod(s // 60, 60)
+    if h:
+        return f"{h} ч {m:02d} мин"
+    if s >= 60:
+        return f"{s // 60} мин {s % 60:02d} с" if s < 600 and s % 60 else f"{s // 60} мин"
+    return f"{s} с"
+
+
+def parse_start(text: str) -> float | None:
+    """«25» = 25 min, «1:10» = 1 min 10 s, «1:10:00» = 1 h 10 min, «1ч 5м», «90 мин» -> seconds; None if unreadable."""
+    t = (text or "").strip().lower().replace(",", ".")
+    if not t:
+        return None
+    if re.fullmatch(r"\d{1,2}(:\d{1,2}){1,2}", t):
+        parts = [int(x) for x in t.split(":")]
+        if any(p >= 60 for p in parts[1:]):
+            return None
+        sec = 0
+        for p in parts:
+            sec = sec * 60 + p
+        return float(sec)
+    m = re.fullmatch(r"(?:(\d+)\s*(?:ч|час[а-я]*|h))?\s*(?:(\d+(?:\.\d+)?)\s*(?:м|мин[а-я]*|m|min))?\s*", t)
+    if m and (m.group(1) or m.group(2)):
+        return float(int(m.group(1) or 0) * 3600 + float(m.group(2) or 0) * 60)
+    if re.fullmatch(r"\d+(?:\.\d+)?", t):
+        return float(t) * 60
+    return None
+
+
+async def _ytdlp(url: str) -> dict | None:
+    if not os.path.exists(YTDLP_BIN):
+        return None
+    try:
+        proc = await asyncio.create_subprocess_exec(
+            YTDLP_BIN, "-J", "--skip-download", "--no-playlist", "--no-warnings", "--socket-timeout", "10", url,
+            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL, cwd="/tmp")
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("probe: cannot start yt-dlp: %s", type(exc).__name__)
+        return None
+    try:
+        out, _ = await asyncio.wait_for(proc.communicate(), timeout=PROBE_TIMEOUT)
+    except asyncio.TimeoutError:
+        proc.kill()
+        return None
+    if proc.returncode != 0 or not out:
+        return None
+    try:
+        j = json.loads(out.decode("utf-8", "replace"))
+    except ValueError:
+        return None
+    return j if isinstance(j, dict) else None
+
+
+async def _oembed(url: str) -> dict | None:
+    try:
+        async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=8)) as s:
+            async with s.get("https://www.youtube.com/oembed", params={"url": url, "format": "json"}) as r:
+                if r.status == 200:
+                    return await r.json(content_type=None)
+    except Exception:  # noqa: BLE001
+        return None
+    return None
+
+
+def _thumb(platform: str, url: str, j: dict) -> str | None:
+    if platform == "youtube":
+        m = _YT_ID.search(url) or _YT_ID.search(str(j.get("webpage_url") or ""))
+        if m:
+            return f"https://i.ytimg.com/vi/{m.group(1)}/hqdefault.jpg"
+    th = j.get("thumbnail")
+    if isinstance(th, str) and th.startswith("https://"):
+        return th
+    for t in reversed(j.get("thumbnails") or []):
+        u = t.get("url") if isinstance(t, dict) else None
+        if isinstance(u, str) and u.startswith("https://") and not u.endswith(".webp"):
+            return u
+    return None
+
+
+async def probe(url: str) -> VideoMeta:
+    platform = platform_of(url) or "link"
+    meta = VideoMeta(platform=platform)
+    j = await _ytdlp(url)
+    if j:
+        meta.title = str(j.get("title") or j.get("fulltitle") or "")[:200]
+        try:
+            meta.duration = float(j["duration"]) if j.get("duration") else None
+        except (TypeError, ValueError):
+            meta.duration = None
+        meta.uploader = str(j.get("uploader") or j.get("channel") or "")[:80]
+        meta.thumb = _thumb(platform, url, j)
+        meta.extra["is_live"] = bool(j.get("is_live"))
+        return meta
+    if platform == "youtube":
+        o = await _oembed(url)
+        if o:
+            meta.title = str(o.get("title") or "")[:200]
+            meta.uploader = str(o.get("author_name") or "")[:80]
+            meta.thumb = _thumb(platform, url, {})
+    return meta
