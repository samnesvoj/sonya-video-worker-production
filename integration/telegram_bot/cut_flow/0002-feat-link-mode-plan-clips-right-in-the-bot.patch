@@ -0,0 +1,226 @@
+"""Dry run of «ссылка → режим → подписка → нарезка» with the REAL new bot code and the REAL production bridge
+(sonya.group/api/telegram/bot/*), a fake Telegram (fake_tg.py) and the test account loadtest+1.
+
+Not touched: real Telegram users, money, Vast. Payment = test mode in the local bridge proxy (checkout/payment are
+answered here, never sent to ЮKassa). Every job the bot creates is cancelled on the server within a second
+(sim_helper.py cancel); the later stages of such a job (анализ → монтаж → готово, 8 clips delivered) are replayed
+by the proxy so the whole progress message can be seen.
+
+  ../venv/bin/python run_sim.py            -> run/transcript.txt, run/bot.log, run/server.log
+"""
+from __future__ import annotations
+
+import asyncio
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import aiohttp
+from aiohttp import web
+
+sys.path.insert(0, str(Path(__file__).parent))
+from fake_tg import FakeTelegram  # noqa: E402
+
+HERE = Path(__file__).parent
+RUN = HERE / "run"
+WORK = HERE.parent / "work"
+PY = HERE.parent / "venv" / "bin" / "python"
+SITE = "root@217.199.252.163"
+U = 900000001            # the scripted user (fake Telegram id, linked to loadtest+1 during the run)
+U_NOSUB = 900000003      # not subscribed to the channel -> the gate
+TG_PORT, PROXY_PORT = 8091, 8092
+REMOTE_PY = "cd /opt/sonya && set -a && . ./.env.local && set +a && .venv/bin/python /root/botlink-stage/sim_helper.py"
+
+LINK_SHORT = "https://www.youtube.com/watch?v=arj7oStGLkU"   # TED, ~14 min
+LINK_PAY = "https://www.youtube.com/watch?v=dQw4w9WgXcQ"     # 3.5 min
+LINK_LONG = "https://www.youtube.com/watch?v=rfscVS0vtbw"    # 4.5 h lecture
+LINK_2K = "https://youtu.be/jNQXAC9IVRw"                     # 19 s
+
+
+class Proxy:
+    """/api/telegram/bot/* -> production, except the payment (test mode) and the replayed stages of cancelled jobs."""
+
+    def __init__(self):
+        self.paid = False
+        self.pay_calls = 0
+        self.replay: dict[str, int] = {}
+        self.log: list[str] = []
+
+    async def handle(self, request: web.Request):
+        full = request.match_info["path"]                    # after /api/
+        path = full.removeprefix("telegram/bot/")
+        body = await request.read()
+        if path == "checkout":
+            self.log.append("checkout (test mode, not sent to ЮKassa)")
+            return web.json_response({"invoice_id": 990001, "status": "pending", "reused": False,
+                                      "redirect_url": "https://yoomoney.ru/checkout/payments/v2/contract?orderId=DRYRUN"})
+        if path == "payment":
+            self.pay_calls += 1
+            return web.json_response({"status": "paid" if self.paid else "pending", "plan_id": "cut_pro"})
+        headers = {k: v for k, v in request.headers.items() if k.lower() in ("x-sonya-bot-secret", "content-type")}
+        async with aiohttp.ClientSession() as s:
+            async with s.post("https://sonya.group/api/" + full, data=body, headers=headers) as r:
+                data = await r.read()
+                status = r.status
+        if path == "job" and status == 200:
+            import json
+            j = json.loads(data)
+            if j.get("status") == "cancelled" and "dry-run" in str(j.get("error") or ""):
+                n = self.replay.get(j["job_id"], 0)
+                self.replay[j["job_id"]] = n + 1
+                seq = [("analyzing", "analyze"), ("mode_running", "analyze"), ("subtitles", "edit"),
+                       ("assembling", "edit")]
+                if n < len(seq):
+                    j.update(status=seq[n][0], stage=seq[n][1], error=None, error_code=None)
+                else:
+                    j.update(status="completed", stage="done", clips=8, error=None, error_code=None,
+                             delivered=min(8, (n - len(seq)) * 4), delivery_failed=0)
+                self.log.append(f"job {j['job_id'][:8]} replay -> {j['status']}")
+                return web.json_response(j)
+        self.log.append(f"{path} -> {status}")
+        return web.Response(body=data, status=status, content_type="application/json")
+
+    def app(self):
+        a = web.Application()
+        a.router.add_post("/api/{path:.*}", self.handle)
+        return a
+
+
+def ssh(cmd: str) -> str:
+    return subprocess.run(["ssh", SITE, cmd], capture_output=True, text=True, timeout=120).stdout.strip()
+
+
+async def main():
+    RUN.mkdir(exist_ok=True)
+    import shutil
+    shutil.rmtree(RUN)
+    RUN.mkdir()
+    print(ssh(f"{REMOTE_PY} setup"))
+    token = subprocess.run(["ssh", SITE, "cat /root/botlink-stage/sim_link_token"], capture_output=True,
+                           text=True).stdout.strip()                     # kept in memory, never printed
+    tg, proxy = FakeTelegram(member_ids=None), Proxy()
+    tg.member_ids = None
+    runners = []
+    for app, port in ((tg.app(), TG_PORT), (proxy.app(), PROXY_PORT)):
+        r = web.AppRunner(app)
+        await r.setup()
+        await web.TCPSite(r, "127.0.0.1", port).start()
+        runners.append(r)
+
+    secret = (HERE / ".secret.env").read_text().split("=", 1)[1].strip()
+    env = dict(os.environ, BOT_TOKEN="123456:DRYRUN", TELEGRAM_API_BASE=f"http://127.0.0.1:{TG_PORT}",
+               SONYA_API_BASE_URL=f"http://127.0.0.1:{PROXY_PORT}/api", SONYA_BOT_BRIDGE_SECRET=secret,
+               DB_PATH=str(RUN / "bot.db"), LOG_DIR=str(RUN / "logs"), REQUIRED_CHANNEL="@sonya_rf_ai",
+               MINIAPP_URL="https://sonya.group/", YTDLP_BIN=str(Path.home() / "SONYA/ytrelay/venv/bin/yt-dlp"),
+               PYTHONUNBUFFERED="1")
+    botlog = open(RUN / "bot.log", "w")
+    bot = subprocess.Popen([str(PY), "main.py"], cwd=WORK, env=env, stdout=botlog, stderr=subprocess.STDOUT)
+    canceller = await asyncio.create_subprocess_exec("ssh", SITE, f"{REMOTE_PY} cancel 900",
+                                                     stdout=open(RUN / "server.log", "w"), stderr=subprocess.STDOUT)
+    steps: list[str] = []
+
+    def mark(s):
+        steps.append(s)
+        tg.messages[max(tg.order)]["mark"] = s if tg.order else None
+        print("·", s, flush=True)
+
+    try:
+        await asyncio.sleep(3)
+        # 0. the channel gate still works (a not-subscribed person sends a link)
+        tg.member_ids = {U}
+        await tg.user_text(U_NOSUB, LINK_SHORT)
+        await tg.wait_for(lambda: "подпишитесь" in tg.last_bot_text())
+        mark("gate: not subscribed -> «Подпишитесь»")
+        # 1. /start + consent + menu «Тарифы» (live prices)
+        await tg.user_text(U, "/start")
+        await tg.idle()
+        await tg.click(U, "✅ Принять")
+        await tg.idle()
+        await tg.click(U, "Тарифы")
+        await tg.wait_for(lambda: "Тарифы SONYA" in tg.last_bot_text())
+        mark("menu «Тарифы» -> live pricing")
+        # 2. a link while the Telegram is NOT linked -> card -> Вирал -> «Привяжите аккаунт»
+        await tg.user_text(U, LINK_SHORT)
+        await tg.wait_for(lambda: "Что сделаем?" in tg.last_bot_text(), 60)
+        mark("card (yt-dlp metadata, no download)")
+        await tg.click(U, "Вирал")
+        await tg.wait_for(lambda: "Привяжите аккаунт" in tg.last_bot_text())
+        await tg.click(U, "Я привязал")
+        await tg.idle()
+        mark("not linked -> login button; «Я привязал» before linking -> alert")
+        # 3. the site's deep link /start TOKEN -> linked -> the same link continues by itself
+        await tg.user_text(U, "/start " + token)
+        await tg.wait_for(lambda: any("Готово — 8" in (m.get("text") or m.get("caption") or "")
+                                      for m in tg.messages.values()), 150)
+        await tg.wait_for(lambda: "Что дальше?" in tg.last_bot_text(), 120)
+        mark("linked via /start TOKEN -> resumed -> job created+cancelled -> replayed stages -> final buttons")
+        # 4. paywall: free quota spent -> tariffs -> «Оформить Pro» (test mode) -> paid -> starts by itself
+        print(ssh(f"{REMOTE_PY} paywall on"))
+        await tg.user_text(U, LINK_PAY)
+        await tg.wait_for(lambda: "Что сделаем?" in tg.last_bot_text(), 60)
+        await tg.click(U, "Хуки")
+        await tg.wait_for(lambda: tg.find_button("Оформить Pro"), 30)
+        await tg.click(U, "Оформить Pro")
+        await tg.wait_for(lambda: "защищённой странице ЮKassa" in tg.last_bot_text())
+        await tg.click(U, "Я оплатил")
+        await tg.idle()
+        mark("tariffs -> checkout -> «Я оплатил» while pending -> alert")
+        print(ssh(f"{REMOTE_PY} paywall off"))
+        proxy.paid = True
+        await tg.wait_for(lambda: sum(1 for m in tg.messages.values() if "Что дальше?" in (m.get("text") or "")) >= 2, 180)
+        mark("payment seen by the tracker -> started without a click -> final buttons")
+        # 5. a long video -> segment -> «Указать начало» -> 1:10:00
+        await tg.user_text(U, LINK_LONG)
+        await tg.wait_for(lambda: "Что сделаем?" in tg.last_bot_text(), 60)
+        await tg.click(U, "Образовательный")
+        await tg.wait_for(lambda: "Видео длиннее лимита" in tg.last_bot_text())
+        await tg.click(U, "Указать начало")
+        await tg.wait_for(lambda: "с какой минуты" in tg.last_bot_text())
+        await tg.user_text(U, "1:10:00")
