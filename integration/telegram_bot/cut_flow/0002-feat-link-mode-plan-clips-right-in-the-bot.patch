+"""Texts + keyboards of «ссылка → режим → нарезка» (owner 2026-11-20). One tone: short, calm, Russian, HTML,
+almost no emoji (a SONYA emoji pack replaces the few marks later: ✓ ● ○ are plain characters).
+Pure functions — tested in tests/test_cut_texts.py.
+"""
+
+from __future__ import annotations
+
+from html import escape
+
+from aiogram.types import InlineKeyboardButton as B
+from aiogram.types import InlineKeyboardMarkup
+
+from .services.media import PLATFORM_RU, fmt_duration
+
+MANAGER_URL = "https://t.me/SonyaAiManager"
+
+CLIPS = {
+    "viral": "Вирал", "streamer": "Стример", "educational": "Образовательный",
+    "story": "Сторителлинг", "hooks": "Хуки", "beep": "BEEP", "trailer": "Трейлер",
+}
+HIGH_CLIPS = ("viral", "story", "hooks")
+PLAN_MODE_OF_CLIP = {"viral": "cut", "story": "cut", "hooks": "cut", "educational": "cut",
+                     "streamer": "streamer", "beep": "beep", "trailer": "trailer"}
+PLAN_MODE_RU = {"cut": "Нарезка", "streamer": "Стример", "beep": "BEEP", "gen": "Gen", "trailer": "Трейлер"}
+STEPS = (("download", "Скачиваем видео"), ("analyze", "Анализ"), ("edit", "Монтаж"), ("done", "Готово"))
+
+
+def plural(n: int, one: str, few: str, many: str) -> str:
+    n10, n100 = n % 10, n % 100
+    if n10 == 1 and n100 != 11:
+        return one
+    if 2 <= n10 <= 4 and not 12 <= n100 <= 14:
+        return few
+    return many
+
+
+def rub(amount) -> str:
+    n = int(amount)
+    return f"{n:,}".replace(",", " ") + " ₽"
+
+
+def minutes_ru(m: int) -> str:
+    if m >= 60 and m % 60 == 0:
+        h = m // 60
+        return f"{h} ч"
+    return f"{m} мин"
+
+
+def cb(run_id: str, action: str, arg: str = "") -> str:
+    return f"cut:{run_id}:{action}" + (f":{arg}" if arg else "")
+
+
+# ── the card ──────────────────────────────────────────────────────────────────
+
+def header(run) -> str:
+    title = escape(run.title) if run.title else ("Видео из Telegram" if run.file_id else "Видео по ссылке")
+    bits = [PLATFORM_RU.get(run.platform, "Ссылка")]
+    if run.duration:
+        bits.append(fmt_duration(run.duration))
+    return f"<b>{title}</b>\n{' · '.join(bits)}"
+
+
+def card_text(run, quality_available: bool = True) -> str:
+    lines = [header(run), "", "<b>Что сделаем?</b>"]
+    if quality_available:
+        if run.quality == "high":
+            lines.append("Качество: 2K — резче, примерно в 3 раза дольше, спишется 3 обработки "
+                         "(Вирал, Сторителлинг, Хуки)")
+        else:
+            lines.append("Качество: Стандарт")
+    return "\n".join(lines)
+
+
+def card_keyboard(run, presets_url: str, quality_available: bool = True) -> InlineKeyboardMarkup:
+    rows = [
+        [B(text="Вирал", callback_data=cb(run.id, "m", "viral")),
+         B(text="Стример", callback_data=cb(run.id, "m", "streamer")),
+         B(text="Образовательный", callback_data=cb(run.id, "m", "educational"))],
+        [B(text="Сторителлинг", callback_data=cb(run.id, "m", "story")),
+         B(text="Хуки", callback_data=cb(run.id, "m", "hooks")),
+         B(text="BEEP", callback_data=cb(run.id, "m", "beep"))],
+    ]
+    if run.is_admin:
+        rows.append([B(text="Трейлер · админ", callback_data=cb(run.id, "m", "trailer"))])
+    if quality_available:
+        std = "✓ Стандарт" if run.quality != "high" else "Стандарт"
+        high = "✓ 2K" if run.quality == "high" else "2K"
+        rows.append([B(text=std, callback_data=cb(run.id, "q", "standard")),
+                     B(text=high, callback_data=cb(run.id, "q", "high"))])
+    rows.append([B(text=f"Стиль: {run.preset or 'Стандарт SONYA'} · изменить", url=presets_url)])
+    return InlineKeyboardMarkup(inline_keyboard=rows)
+
+
+# ── account link ──────────────────────────────────────────────────────────────
+
+def link_text(run) -> str:
+    return (f"{header(run)}\n\n<b>Привяжите аккаунт SONYA</b>\n"
+            "Обработки и тариф хранятся в аккаунте на sonya.group. Войдите и подключите Telegram — "
+            "это один раз. Ссылку я запомнил: после привязки сразу продолжу.")
+
+
+def link_keyboard(run, connect_url: str) -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup(inline_keyboard=[
+        [B(text="Войти и привязать", url=connect_url)],
+        [B(text="Я привязал — продолжить", callback_data=cb(run.id, "relink"))],
+        [B(text="Назад", callback_data=cb(run.id, "back"))],
+    ])
+
+
+# ── tariffs ───────────────────────────────────────────────────────────────────
+
+def _plan_name(p: dict) -> str:
+    pid = p["plan_id"]
+    if p.get("kind") == "pack":
+        return f"Пакет {PLAN_MODE_RU.get(p['mode'], p['mode'])}"
+    tier = pid.split("_", 1)[-1].capitalize()
+    return tier
+
+
+def _plan_line(p: dict) -> str:
+    if p.get("kind") == "pack":
+        unit = "изображений" if p["mode"] == "gen" else plural(p["ops"], "обработка", "обработки", "обработок")
+        return f"<b>{_plan_name(p)}</b> · {rub(p['price'])}\n{p['ops']} {unit}, не сгорает"
+    ops = plural(p["ops"], "обработка", "обработки", "обработок")
+    return (f"<b>{_plan_name(p)}</b> · {rub(p['price'])}/мес\n"
+            f"{p['ops']} {ops} · видео до {minutes_ru(p['max_source_minutes'])}")
+
+
+def plans_for(plans: list[dict], plan_mode: str) -> list[dict]:
+    order = {"start": 0, "pro": 1, "studio": 2}
+    out = [p for p in plans if p.get("mode") == plan_mode]
+    return sorted(out, key=lambda p: (order.get(p["plan_id"].split("_", 1)[-1], 9), p["price"]))
+
+
+def reason_text(code: str | None, message: str | None) -> str:
+    if code == "FREE_PLAN_USED":
+        return "Бесплатная обработка уже использована."
+    if code == "PLAN_LIMIT_REACHED":
+        return escape(message or "Обработки на тарифе закончились.")
+    if code in ("MODE_NOT_IN_PLAN", "SUBSCRIPTION_EXPIRED"):
+        return escape(message or "Для этого режима нужен тариф.")
+    return escape(message) if message else "Для обработки нужен тариф."
+
+
+def tariffs_text(run, plans: list[dict], plan_mode: str, code: str | None, message: str | None) -> str:
+    mine = plans_for(plans, plan_mode)
+    title = "Пакет BEEP" if plan_mode == "beep" else f"Тариф «{PLAN_MODE_RU.get(plan_mode, plan_mode)}»"
+    parts = [header(run), "", f"<b>{title}</b>", reason_text(code, message), ""]
+    parts += [_plan_line(p) for p in mine]
+    parts += ["", "Оплата картой или СБП через ЮKassa. После оплаты запущу нарезку сам."]
+    return "\n".join(parts)
+
+
+def tariffs_keyboard(run, plans: list[dict], plan_mode: str, tariffs_url: str) -> InlineKeyboardMarkup:
+    mine = plans_for(plans, plan_mode)
+    rows = [[B(text=f"Оформить {_plan_name(p)} · {rub(p['price'])}", callback_data=cb(run.id, "buy", p["plan_id"]))]
+            for p in mine]
+    rows.append([B(text="Все тарифы на сайте", url=tariffs_url)])
+    rows.append([B(text="Назад", callback_data=cb(run.id, "back"))])
+    return InlineKeyboardMarkup(inline_keyboard=rows)
+
+
+def pay_text(run, plan: dict) -> str:
+    name = f"{PLAN_MODE_RU.get(plan['mode'], plan['mode'])} {_plan_name(plan)}" if plan.get("kind") != "pack" \
+        else _plan_name(plan)
+    return (f"{header(run)}\n\n<b>{name} — {rub(plan['price'])}</b>\n"
+            "Оплата на защищённой странице ЮKassa. Как только платёж пройдёт, я сам запущу нарезку.")
+
+
+def pay_keyboard(run, plan: dict, pay_url: str) -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup(inline_keyboard=[
+        [B(text=f"Оплатить {rub(plan['price'])}", url=pay_url)],
+        [B(text="Я оплатил — запустить", callback_data=cb(run.id, "paid"))],
+        [B(text="Назад к тарифам", callback_data=cb(run.id, "tariffs"))],
+    ])
+
+
+def general_pricing_text(plans: list[dict]) -> str:
+    parts = ["<b>Тарифы SONYA</b>", ""]
+    for mode, title in (("cut", "Нарезка — Вирал, Сторителлинг, Хуки, Образовательный"), ("streamer", "Стример")):
+        mine = plans_for(plans, mode)
+        if mine:
+            parts.append(f"<b>{title}</b>")
+            parts += [_plan_line(p) for p in mine]
+            parts.append("")
+    packs = [p for p in plans if p.get("kind") == "pack"]
+    if packs:
+        parts.append("<b>Пакеты</b>")
+        parts += [_plan_line(p) for p in packs]
+        parts.append("")
+    parts.append("Пришлите ссылку на видео — подберу тариф под режим и запущу нарезку сразу после оплаты.")
+    return "\n".join(parts)
+
+
+# ── segment of a long video ───────────────────────────────────────────────────
+
+def segment_text(run, cap_min: int) -> str:
+    dur = fmt_duration(run.duration) if run.duration else "дольше лимита"
+    return (f"{header(run)}\n\n<b>Видео длиннее лимита</b>\n"
+            f"Видео идёт {dur}, на вашем тарифе — до {minutes_ru(cap_min)} за раз. Какой отрезок взять?")
+
+
+def segment_keyboard(run, cap_min: int) -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup(inline_keyboard=[
+        [B(text=f"Первые {minutes_ru(cap_min)}", callback_data=cb(run.id, "first"))],
+        [B(text="Указать начало", callback_data=cb(run.id, "start_at"))],
+        [B(text="Назад", callback_data=cb(run.id, "back"))],
+    ])
+
+
+def ask_start_text(cap_min: int) -> str:
+    return (f"Напишите, с какой минуты начать — например <code>25</code> или <code>1:10:00</code>. "
+            f"Возьму {minutes_ru(cap_min)} от этой точки.")
+
+
+# ── progress ──────────────────────────────────────────────────────────────────
+
+def mode_line(run) -> str:
+    bits = [CLIPS.get(run.clip or "", "")]
+    if run.clip in HIGH_CLIPS:
+        bits.append("2K" if run.quality == "high" else "Стандарт")
+    if run.preset and run.preset != "Стандарт SONYA" and run.clip != "beep":
+        bits.append(escape(run.preset))
+    if run.trim_end:
+        st = int(run.trim_start or 0)
+        bits.append(f"отрезок {fmt_clock(st)}–{fmt_clock(int(run.trim_end))}")
+    return " · ".join(b for b in bits if b)
+
+
+def fmt_clock(sec: int) -> str:
+    h, rem = divmod(int(sec), 3600)
+    m, s = divmod(rem, 60)
+    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"
+
+
+def progress_text(run) -> str:
+    lines = [header(run), mode_line(run), ""]
+    if run.state == "starting" or not run.stage:
+        lines.append("Запускаю…")
+        return "\n".join(lines)
+    stage = run.stage
+    downloaded = bool(run.extra.get("downloaded"))
+    queue = stage == "queue"
+    cur = {"download": 0, "analyze": 1, "edit": 2, "done": 3}.get(stage, 1 if downloaded else 0)
+    if queue:
+        cur = 1 if downloaded else 0
+    for i, (_key, label) in enumerate(STEPS):
+        if i < cur or stage == "done":
+            lines.append(f"✓ {label}")
+        elif i == cur:
+            suffix = " · в очереди" if queue else "…"
+            lines.append(f"● <b>{label}</b>{suffix}")
+        else:
+            lines.append(f"○ {label}")
+    if run.notice:
+        lines += ["", f"<i>{escape(run.notice)}</i>"]
+    return "\n".join(lines)
+
+
+def done_text(run) -> str:
+    n = run.clips
+    word = plural(n, "клип", "клипа", "клипов")
+    return (f"{header(run)}\n{mode_line(run)}\n\n<b>Готово — {n} {word}.</b>\n"
+            "Присылаю их сюда, следом — ссылка на все в «Работах».")
+
+
+def final_text(run) -> str:
+    n = run.clips
+    return f"Все {n} {plural(n, 'клип', 'клипа', 'клипов')} выше. Что дальше?" if n != 1 else "Клип выше. Что дальше?"
+
+
+def final_keyboard(run, works_url: str) -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup(inline_keyboard=[
+        [B(text="Ещё нарезку", callback_data=cb(run.id, "again")),
+         B(text="Открыть в Работах", url=works_url)],
+    ])
+
+
+def failed_text(run, reason: str) -> str:
+    return f"{header(run)}\n{mode_line(run)}\n\n<b>Не получилось.</b> {reason}"
+
+
+def failed_keyboard(run) -> InlineKeyboardMarkup:
+    return InlineKeyboardMarkup(inline_keyboard=[
+        [B(text="Другой режим", callback_data=cb(run.id, "again")),
+         B(text="Написать нам", url=MANAGER_URL)],
+    ])
+
+
+# ── errors in plain words ─────────────────────────────────────────────────────
+
+NOTICE_YT = "YouTube сейчас отдаёт видео медленно — ждём его. Это может занять до пары часов, клипы пришлём сами."
+NOTICE_LOAD = "Высокая нагрузка — клипы будут чуть позже, пришлём сюда сами."
+UNSUPPORTED = ("Такие ссылки я пока не беру. Подойдут YouTube, VK Видео, Rutube и Twitch — "
+               "или пришлите сам видеофайл.")
+TOO_BIG_FILE = ("Файл больше 20 МБ — Telegram не даёт ботам скачивать такие. "
+                "Пришлите ссылку на видео или загрузите файл на сайте.")
+BUSY = "Сейчас уже идёт обработка — дождитесь её, и запущу следующую."
+DOWN = "SONYA сейчас недоступна. Попробуйте через пару минут."
+GENERIC_FAIL = ("Не вышло сделать клипы из этого видео. Попробуйте другой режим или другое видео — "
+                "или напишите нам, разберёмся.")
+NOT_CHARGED = " Обработка не списана."
+
+
+def human_error(code: str | None, message: str | None) -> str:
+    c = (code or "").upper()
+    if c in ("UNSUPPORTED_URL",):
+        return UNSUPPORTED
+    if c in ("UNSAFE_URL",):
+        return "Эта ссылка недоступна для загрузки. Проверьте, что видео открыто для всех."
+    if c in ("HTTP_429", "RATE_LIMITED", "TOO_MANY_ACTIVE_JOBS", "CONCURRENT_LIMIT"):
+        return BUSY
+    if c in ("UNAVAILABLE", "NOT_CONFIGURED", "HTTP_502", "HTTP_503", "HTTP_500", "DB_ERROR", "INTERNAL_ERROR",
+             "STORAGE_ERROR"):
+        return DOWN
+    if c in ("TRAILER_DISABLED", "MODE_DISABLED"):
+        return "Этот режим сейчас выключен."
+    if message and c.startswith(("SOURCE_", "DOWNLOAD_", "LIMIT_")):
+        return escape(message)
+    if c in ("DOWNLOAD_FAILED", "LIMIT_EXCEEDED", "INVALID_VIDEO") and message:
+        return escape(message)
+    if message and c in ("SOURCE_TRIM_RANGE", "TRIM_RANGE", "QUALITY_UNITS_SHORT"):
+        return escape(message)
+    return GENERIC_FAIL
