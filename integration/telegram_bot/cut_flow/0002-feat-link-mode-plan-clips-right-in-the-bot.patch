+"""Dry-run helper on the site VPS (run with /opt/sonya/.venv/bin/python, cwd /opt/sonya, env .env.local).
+Test account only (loadtest+1@sonya.invalid). Never prints tokens/secrets: the link token goes to a 0600 file.
+
+  setup           remember the account's telegram + free-quota fields, unlink, write a one-time link token file
+  paywall on|off  free quota spent (free_video_limit = used) / back to the remembered limit
+  cancel SECONDS  every 0.3 s: cancel any queued/source_wait job of the account created after setup (no Vast)
+  teardown        cancel leftovers, restore the remembered fields, report the jobs created by the run
+"""
+import json
+import os
+import sys
+import time
+
+import psycopg2
+import psycopg2.extras
+
+EMAIL = "loadtest+1@sonya.invalid"
+STATE = "/root/botlink-stage/sim_state.json"
+TOKEN_FILE = "/root/botlink-stage/sim_link_token"
+
+
+def conn():
+    c = psycopg2.connect(os.environ["DATABASE_URL"], cursor_factory=psycopg2.extras.RealDictCursor)
+    c.autocommit = True
+    return c
+
+
+def user(cur):
+    cur.execute("SELECT * FROM users WHERE email=%s", (EMAIL,))
+    return cur.fetchone()
+
+
+def main():
+    cmd = sys.argv[1]
+    c = conn()
+    cur = c.cursor()
+    u = user(cur)
+    if cmd == "setup":
+        st = {k: (u[k].isoformat() if hasattr(u[k], "isoformat") else u[k]) for k in
+              ("id", "telegram_linked", "telegram_user_id", "telegram_chat_id", "telegram_linked_at",
+               "free_video_limit", "free_video_used")}
+        cur.execute("SELECT now() AS t")
+        st["t0"] = cur.fetchone()["t"].isoformat()
+        json.dump(st, open(STATE, "w"))
+        cur.execute("UPDATE users SET telegram_linked=false, telegram_user_id=NULL, telegram_chat_id=NULL, "
+                    "telegram_linked_at=NULL WHERE id=%s", (u["id"],))
+        sys.path.insert(0, "/opt/sonya")
+        from scripts import telegram_store
+        tok = telegram_store.create_link_token(str(u["id"]))
+        raw = tok.get("token") if isinstance(tok, dict) else tok
+        fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        os.write(fd, str(raw).encode())
+        os.close(fd)
+        print("setup ok user", str(u["id"])[:8], "free", u["free_video_used"], "/", u["free_video_limit"])
+    elif cmd == "paywall":
+        st = json.load(open(STATE))
+        if sys.argv[2] == "on":
+            cur.execute("UPDATE users SET free_video_limit=free_video_used WHERE id=%s", (u["id"],))
+        else:
+            cur.execute("UPDATE users SET free_video_limit=free_video_used + %s WHERE id=%s",
+                        (max(1, st["free_video_limit"] - st["free_video_used"]), u["id"]))
+        print("paywall", sys.argv[2])
+    elif cmd == "cancel":
+        st = json.load(open(STATE))
+        end = time.time() + float(sys.argv[2])
+        while time.time() < end:
+            cur.execute("UPDATE generation_jobs SET status='cancelled', error='bot dry-run (test, cancelled at once)', "
+                        "updated_at=now() WHERE user_id::text=%s AND created_at > %s AND status IN ('queued','source_wait') "
+                        "RETURNING id, mode, params->>'clipType' AS clip, created_at", (st["id"], st["t0"]))
+            for r in cur.fetchall():
+                age = time.time() - r["created_at"].timestamp()
+                print("cancelled", str(r["id"])[:8], r["mode"], r["clip"], "after %.1f s" % age, flush=True)
+            time.sleep(0.3)
+    elif cmd == "teardown":
+        st = json.load(open(STATE))
+        cur.execute("UPDATE generation_jobs SET status='cancelled', error='bot dry-run (test)' WHERE user_id::text=%s "
+                    "AND created_at > %s AND status NOT IN ('completed','failed','cancelled') RETURNING id",
+                    (st["id"], st["t0"]))
+        left = cur.fetchall()
+        cur.execute("SELECT id, mode, status, worker_id, params->>'clipType' clip, params->'settings'->>'quality' q, "
+                    "params->>'trim_start_sec' ts, params->>'trim_end_sec' te, params->>'frontend' fe, "
+                    "params->'settings'->>'preset' preset, s3_input_key FROM generation_jobs "
+                    "WHERE user_id::text=%s AND created_at > %s ORDER BY created_at", (st["id"], st["t0"]))
+        jobs = cur.fetchall()
+        cur.execute("UPDATE users SET telegram_linked=%s, telegram_user_id=%s, telegram_chat_id=%s, telegram_linked_at=%s, "
+                    "free_video_limit=%s, free_video_used=%s WHERE id=%s",
+                    (st["telegram_linked"], st["telegram_user_id"], st["telegram_chat_id"], st["telegram_linked_at"],
+                     st["free_video_limit"], st["free_video_used"], u["id"]))
+        cur.execute("UPDATE telegram_link_tokens SET used_at=COALESCE(used_at, now()) WHERE user_id::text=%s", (st["id"],))
+        for j in jobs:
+            print("job", str(j["id"])[:8], j["mode"], j["clip"], j["status"], "worker=%s" % (j["worker_id"] or "-"),
+                  "q=%s" % j["q"], "trim=%s-%s" % (j["ts"], j["te"]), j["fe"], "preset=%s" % j["preset"])
+        print("leftovers cancelled:", len(left), "| restored free %s/%s, telegram_linked=%s" % (
+            st["free_video_used"], st["free_video_limit"], st["telegram_linked"]))
+        try:
+            os.remove(TOKEN_FILE)
+        except OSError:
+            pass
+
+
+if __name__ == "__main__":
+    main()
