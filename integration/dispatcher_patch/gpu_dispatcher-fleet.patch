+def _fleet_tick() -> None:
+    """Never raises: a fleet problem must not stop the legacy per-job dispatch."""
+    global _FLEET
+    if not FLEET_ENABLED:
+        return
+    try:
+        if _FLEET is None:
+            from dispatcher.main import build_fleet
+            _FLEET = build_fleet()
+        _FLEET.tick()
+    except Exception as exc:  # noqa: BLE001
+        logger.error("fleet_tick_error exc=%s", type(exc).__name__)
