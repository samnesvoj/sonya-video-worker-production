# Direct runtime dependencies of the GPU worker; exact versions + hashes live in worker.lock.txt.
--extra-index-url https://download.pytorch.org/whl/cu126
# torch, torchvision and torchaudio come from the SAME PyTorch index as a matched binary set (torchaudio has no build for torch >= 2.12,
# so 2.11 is the newest torch with a binary-compatible torchaudio). GigaAM (primary ASR) needs torch/torchaudio >= 2.6.
torch==2.11.0+cu126
torchvision==0.26.0+cu126
torchaudio==2.11.0+cu126
